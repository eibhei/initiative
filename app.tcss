AddActor {
    align: center middle;
}

#overlay {
    /*grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;*/
    padding: 0 1;
    width: 90%;
    height: 90%;
    border: thick $background 80%;
    /*background: $surface;*/
}

#overlay Button {
    width: 100%;
    height: 3;
    margin: 1 1 1 13;
}

Rule {
    width: 100%;
    margin: 1 5 0 5;
    align: center top;
    layout: horizontal;
}

LabelledInput {
    layout: horizontal;
    height: 3;
    margin: 1;
}

LabelledInput Label {
    width: 12;
    text-align: left;
    padding-top: 1;
    padding-bottom: 1;
}

LabelledInput Input {
    width: 1fr;
    height: 3;
    /*margin: 0;*/
}

RoundTracker {
    margin-top: 1;
    margin-bottom: 1;
    layout: horizontal;
    align: center bottom;
    height: 3;
    width: 100%;
    padding: 0;
    margin: 0;
}

RoundTracker Label {
    margin-top: 1;
    width: 25%;
}

RoundTracker ProgressBar {
    margin-top: 1;
    width: 25%;
}

RoundTracker Button {
    width: 25%;
    height: 100%;
    margin: 0;
}
